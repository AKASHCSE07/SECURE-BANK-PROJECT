# ==============================================================================
# SECUREBANK ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file's values into:
#   backend/src/main/resources/application.properties
#
# NEVER commit real passwords, secrets, or API keys to version control.
# ==============================================================================

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securebank_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# --- JWT ---
# Must be a 64-character hex string (256-bit). Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_64_char_hex_secret_here
JWT_EXPIRATION_MS=86400000

# --- Server ---
SERVER_PORT=8080
